# Data Ingestion Environment Variables Template for Reg-Guru
# Copy this file to .env and fill in the actual values

# AWS S3 Configuration
AWS_ACCESS_KEY_ID='your-s3-access-key-id'
AWS_SECRET_ACCESS_KEY='your-s3-secret-access-key'

# AWS RDS PostgreSQL Configuration
DB_HOST='your-database-host'
DB_PORT='5433'
DB_USER='your-database-username'
DB_PASSWORD='your-database-password'
DB_NAME='your-database-name'

# ChromaDB (remote vector store)
CHROMADB_HOST='ec2-13-228-79-108.ap-southeast-1.compute.amazonaws.com'
CHROMADB_PORT='80'
CHROMADB_COLLECTION='reg_guru_embeddings'
CHROMADB_AUTH_TOKEN=''  # optional: set if the deployment requires Bearer auth
