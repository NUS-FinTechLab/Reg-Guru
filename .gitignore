# Environment files (ignore actual .env files but allow templates)
*.env
*.env.local
*.env.development
*.env.test
*.env.production
backend/.env
frontend/.env*
data_ingestion/.env

# Allow environment template files to be committed
!*.env.template
!backend/.env.template
!frontend/.env.template
!data_ingestion/.env.template

# ChromaDB data
data_ingestion/chroma/*
data_ingestion/raw/*
